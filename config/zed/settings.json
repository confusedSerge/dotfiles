{
    "ui_font_size": 14.0,
    "buffer_font_size": 13.0,
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },

    // Theme
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Ayu Dark",
    },
    // "buffer_font_family": "SF Mono",
    "buffer_line_height": "standard",
    "scrollbar": {
        "show": "never",
    },

    // Keybindings
    "base_keymap": "JetBrains",
    "vim_mode": true,
    "relative_line_numbers": "enabled",

    // Other
    "soft_wrap": "editor_width",
    "tab_size": 4,
}
